# Copy to .env for local docker-compose. Never commit the real .env (see .gitignore).
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=changeme

# Production only (Oracle VM) -- leave unset for local dev, where docker-compose.yml's default
# falls back to building images from source instead. Set this to ghcr.io/<your-github-username>
# once the repo exists and .github/workflows/ci.yml has pushed at least one image, so
# `docker compose pull` on the VM fetches the CI-built image instead of trying to build Java
# from source on the deploy target.
# GHCR_NAMESPACE=ghcr.io/your-github-username

# Production only -- the Vercel dashboard's actual origin, so scheduler-service's CORS config
# (WebCorsConfig) allows it. Local dev's default (http://localhost:3000) needs no override.
# DASHBOARD_ALLOWED_ORIGINS=https://your-dashboard.vercel.app,https://*.vercel.app
